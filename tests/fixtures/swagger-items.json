{
  "swagger": "2.0",
  "info": {"title": "Swagger sample", "version": "1.0.0"},
  "basePath": "/v2",
  "produces": ["application/json"],
  "paths": {
    "/items": {
      "post": {
        "operationId": "createItem",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["sku"],
              "properties": {
                "sku": {"type": "string", "minLength": 2, "maxLength": 4},
                "note": {"type": "string", "minLength": 1, "maxLength": 6}
              }
            }
          }
        ],
        "responses": {"200": {"description": "ok"}}
      }
    },
    "/notes": {
      "post": {
        "operationId": "createNote",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": false,
            "schema": {
              "type": "object",
              "required": ["sku"],
              "properties": {
                "sku": {"type": "string", "minLength": 2, "maxLength": 4},
                "note": {"type": "string", "minLength": 1, "maxLength": 6}
              }
            }
          }
        ],
        "responses": {"200": {"description": "ok"}}
      }
    }
  }
}
